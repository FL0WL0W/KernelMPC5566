{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "MPC5566-Release",
      "displayName": "MPC5566 Clang Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-mcpu=e200z6 -Oz -DNDEBUG -Wall -Wextra",
        "CMAKE_CXX_FLAGS_RELEASE": "-mcpu=e200z6 -Oz -DNDEBUG -flto=full -Wall -Wextra",
        "CMAKE_ASM_FLAGS_RELEASE": "-mcpu=e200z6",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-flto=full -Wl,--gc-sections -Wl,-Map,firmware.map -T\"${sourceDir}/MPC5566_RAM.ld\"",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "MPC5566-Release",
      "configurePreset": "MPC5566-Release"
    }
  ]
}
